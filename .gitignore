# Video files and clip folders — too large for git.
# The app reads these at runtime; they live on disk, not in the repo.
*.mp4
*.MP4
*.mkv
*.MKV
*.webm
*.mov
*.m4v
*_clips/

# NOTE: videos.js IS committed now — it holds only public Bunny HLS URLs
# (no local paths, no secrets) and is what the deployed site loads.

# Bunny secrets (keep keys out of git)
bunny_config.json
bunny_upload_errors.log
# NOTE: bunny_uploads.json IS committed now — it's the canonical clip->GUID map
# (no secrets). Keeping it in git means a re-sync never loses your upload record.

# TMDB key (secret). films.json IS deployed — it's the public film catalog the
# film pages read (only public TMDB data, no secrets).
tmdb_config.json

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
